# LOCAL DEVELOPMENT ONLY — copy to secrets.toml (git-ignored). Not used in Streamlit in Snowflake.
# Easiest: skip this file and run with SNOWFLAKE_DEFAULT_CONNECTION_NAME=<your snow CLI connection>.

# Optional: where the framework objects live (default DQ_FRAMEWORK.CORE)
# DQ_FRAMEWORK_SCHEMA = "DQ_FRAMEWORK.CORE"
# DQ_APP_TITLE = "Data Quality Monitor"

# [connections.snowflake]
# account = "ORGNAME-ACCTNAME"
# user = "me@example.com"
# authenticator = "externalbrowser"
# role = "DQ_ADMIN"
# warehouse = "DQ_WH"
# database = "DQ_FRAMEWORK"
# schema = "CORE"
